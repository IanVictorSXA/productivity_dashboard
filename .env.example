# Google Sheets sync (Phase 3). Copy to `.env`, fill in real values, never commit `.env` itself.
# Read by docker-compose.yml and backend/sheets_config.py.

# Master switch. Leave unset/false on any machine without a service-account key.
SHEETS_SYNC_ENABLED=false

# Absolute path, on the host, to the downloaded service-account key JSON.
# docker-compose mounts this read-only into the backend container.
SHEETS_KEY_FILE_HOST=/absolute/path/to/service-account-key.json

# The spreadsheet's id (the long token in its URL between /d/ and /edit).
SHEETS_SPREADSHEET_ID=

# Tab name holding the day's column-A schedule. Defaults to "Day" if unset.
SHEETS_TAB_NAME=Day
