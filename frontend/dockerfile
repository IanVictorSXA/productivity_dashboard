# -slim, not -alpine: the three native deps (@rollup/rollup-linux-arm64-gnu,
# @tailwindcss/oxide-linux-arm64-gnu, lightningcss-linux-arm64-gnu) are
# prebuilt glibc binaries, so musl would break all three.
FROM node:22-slim

WORKDIR /app

# Copy package files first to leverage Docker cache layers.
# The wildcard picks up package-lock.json, which npm ci requires.
COPY package*.json ./

# ci, not install: builds exactly the committed lockfile, and fails loudly if
# it and package.json disagree.
RUN npm ci

# Copy the rest of the application files
COPY . .

# Expose your application port (e.g., 5173)
EXPOSE 5173

# Run the live-reload script
CMD ["npm", "run", "dev", "--", "--host"]